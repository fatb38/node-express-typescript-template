{
  "name": "node-express-typescript-template",
  "version": "1.1.0",
  "private": false,
  "description": "A from scratch template to create server app with NodeJS / Express / TypeScript",
  "author": "fatb38",
  "main": "src/app.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/fatb38/node-express-typescript-template.git"
  },
  "scripts": {
    "build": "tsc",
    "ts-check": "tsc --noEmit",
    "clean": "rm -rf build coverage",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "lint": "eslint . --ext .ts",
    "start": "node build/app.js",
    "test": "jest"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  },
  "license": "MIT"
}
